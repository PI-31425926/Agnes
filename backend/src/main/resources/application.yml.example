server:
  port: 8080

agnes:
  api-url: https://apihub.agnes-ai.com/v1/chat/completions
  model: agnes-2.0-flash
  image-api-url: https://apihub.agnes-ai.com/v1/images/generations
  image-model: agnes-image-2.1-flash
  image-to-image-model: agnes-image-2.1-flash
  video-api-url: https://apihub.agnes-ai.com/v1/videos
  video-status-url: https://apihub.agnes-ai.com/agnesapi
  video-model: agnes-video-v2.0

music:
  api-url: http://localhost:8000
  timeout: 30000

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/agnes?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
    username: root
    password: YOUR_DB_PASSWORD
    driver-class-name: com.mysql.cj.jdbc.Driver
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: false
    properties:
      hibernate:
        dialect: org.hibernate.dialect.MySQLDialect
  web:
    resources:
      static-locations: classpath:/static/
  mvc:
    static-path-pattern: /**
  data:
    redis:
      host: localhost
      port: 6379
      password:
      timeout: 3000ms
      lettuce:
        pool:
          max-active: 8
          max-idle: 8
          min-idle: 2
  servlet:
    multipart:
      max-file-size: 10MB
      max-request-size: 50MB

aes:
  secret: YOUR_AES_SECRET
jwt:
  secret: YOUR_JWT_SECRET
  expiration: 86400000

sa-token:
  token-name: Authorization
  timeout: 8640000
  is-read-cookie: false
  is-read-head: true
  token-prefix: "Bearer"

oss:
  endpoint: oss-cn-beijing.aliyuncs.com
  bucket-name: YOUR_BUCKET_NAME
  access-key-id: YOUR_OSS_ACCESS_KEY_ID
  access-key-secret: YOUR_OSS_ACCESS_KEY_SECRET
  cname-url: https://YOUR_BUCKET.oss-cn-beijing.aliyuncs.com
